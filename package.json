{
  "name": "milestone-renovate-site",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Premium Australian renovation website and client enquiry platform for Milestone Renovate.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build:site": "python build_site.py",
    "build:brand": "node scripts/make-brand-assets.mjs",
    "build:images": "node scripts/make-responsive-images.mjs",
    "dev": "node scripts/dev-server.mjs",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.2.0",
    "@playwright/test": "^1.64.0",
    "sharp": "^0.35.5"
  }
}
