# Copy to .env.local for local work. NEVER commit real values. Set production values in Vercel (server-side only).

# Supabase (server-only; the service-role key must never reach the browser)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Random 32+ char secret used to HMAC visitor IPs before storage (rate limiting without keeping raw IPs)
IP_HASH_SECRET=

# Resend staff notifications (optional: leads are still stored if unset; notification_status becomes 'skipped')
RESEND_API_KEY=
NOTIFY_TO_EMAIL=
NOTIFY_FROM_EMAIL=Milestone Renovate <enquiries@your-verified-domain>

# Comma-separated origins allowed to POST /api/enquiries
ALLOWED_ORIGINS=https://milestonerenovate.com
